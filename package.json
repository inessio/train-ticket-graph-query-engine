{
  "name": "train-ticket-graph-query-engine",
  "version": "1.0.0",
  "author": "Komla Sodji",
  "description": "REST API that loads a Train Ticket microservice graph and supports pluggable route filters.",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit --forceExit",
    "test:integration": "jest tests/integration --forceExit --runInBand",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src --ext .ts",
    "docker:build": "docker build -f docker/Dockerfile -t train-ticket-api .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f api",
    "docker:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up --build",
    "docker:dev:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml down"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
